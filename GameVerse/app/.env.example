# GameVerse Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your local .env file with secrets to the repository!

# Google Cloud & GenAI Configuration (for VertexAI and Gemini integrations)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Supabase Local or Production Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# LiveKit Configuration (optional, if running custom credentials)
# LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-server-api-secret-strictly-for-edge-functions

# Twitch / IGDB API Credentials (for Clever API search proxy)
# TWITCH_CLIENT_ID=your-twitch-client-id
# TWITCH_CLIENT_SECRET=your-twitch-secret-strictly-for-edge-functions
